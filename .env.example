# Weather-AI API key (required) — https://weather-ai.co/docs
WAI_API_KEY=wai_your_key_here

# Optional: Google Gemini for extra farmer tips (POST /api/farmer-advice)
GEMINI_API_KEY=
# See https://ai.google.dev/gemini-api/docs — default tries 2.5-flash first
GEMINI_MODEL=gemini-2.5-flash

# Optional: show "Gemini" in footer when deployed
NEXT_PUBLIC_HAS_GEMINI=false

# Public webhook URL shown in UI (your Render URL)
NEXT_PUBLIC_WEBHOOK_URL=https://shamba-sky.onrender.com/webhook

# Optional: require this secret on incoming POST /webhook (header x-webhook-secret)
WEBHOOK_SECRET=
